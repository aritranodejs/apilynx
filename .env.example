# =============================================================================
# Apilynx — environment template
# Copy to .env and fill in values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database (desktop app — required for packaged installs)
# Local default is fine for development. Use Atlas (or any remote URI) before
# packaging installers (npm run dist / electron:build).
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/apilynx

# -----------------------------------------------------------------------------
# Google sign-in (desktop app — optional)
# Leave empty to hide Google auth until configured.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Public site / product (baked into the Next.js UI at build time)
# Prefix NEXT_PUBLIC_ is required so the browser bundle can read these.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Apilynx
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_REPO=aritranodejs/apilynx

# Master switch for desktop download buttons (true / false)
# Keep false until real installer files are reachable — avoids 404 links.
NEXT_PUBLIC_DOWNLOADS_LIVE=false

# Base URL for installers when a specific URL below is empty.
# Prefer leaving this empty and setting only platforms you actually built,
# so missing OS buttons stay “Coming soon” instead of 404.
# Examples when you host everything under public/downloads/:
#   NEXT_PUBLIC_DOWNLOAD_BASE_URL=/downloads
NEXT_PUBLIC_DOWNLOAD_BASE_URL=

# Per-platform URLs (recommended). After publishing a GitHub Release:
#   NEXT_PUBLIC_DOWNLOAD_LINUX_DEB_URL=https://github.com/OWNER/REPO/releases/download/v1.0.0/apilynx_1.0.0_amd64.deb
#   NEXT_PUBLIC_DOWNLOAD_LINUX_APPIMAGE_URL=https://github.com/OWNER/REPO/releases/download/v1.0.0/Apilynx-1.0.0.AppImage
# Later add Windows/macOS the same way (leave empty = Coming soon):
#   NEXT_PUBLIC_DOWNLOAD_WINDOWS_URL=https://github.com/.../Apilynx-Setup-1.0.0.exe
#   NEXT_PUBLIC_DOWNLOAD_MAC_ARM_URL=https://github.com/.../Apilynx-1.0.0-arm64.dmg
#   NEXT_PUBLIC_DOWNLOAD_MAC_INTEL_URL=https://github.com/.../Apilynx-1.0.0-x64.dmg
# Re-upload / update assets anytime:
#   bash scripts/publish-release.sh v1.0.0 --assets-only
NEXT_PUBLIC_DOWNLOAD_WINDOWS_URL=
NEXT_PUBLIC_DOWNLOAD_MAC_ARM_URL=
NEXT_PUBLIC_DOWNLOAD_MAC_INTEL_URL=
NEXT_PUBLIC_DOWNLOAD_LINUX_DEB_URL=
NEXT_PUBLIC_DOWNLOAD_LINUX_APPIMAGE_URL=

# Optional custom filenames (defaults use NEXT_PUBLIC_APP_VERSION)
NEXT_PUBLIC_DOWNLOAD_WINDOWS_FILENAME=
NEXT_PUBLIC_DOWNLOAD_MAC_ARM_FILENAME=
NEXT_PUBLIC_DOWNLOAD_MAC_INTEL_FILENAME=
NEXT_PUBLIC_DOWNLOAD_LINUX_DEB_FILENAME=
NEXT_PUBLIC_DOWNLOAD_LINUX_APPIMAGE_FILENAME=
